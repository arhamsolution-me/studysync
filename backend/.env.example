# StudySync AI — Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studysync?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Groq API (Whisper STT + Llama Intent Classifier)
GROQ_API_KEY=

# Google Gemini API (Structured extraction + Tone generation)
GEMINI_API_KEY=

# SendGrid (Email Reminders)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=reminders@studysync.ai

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
